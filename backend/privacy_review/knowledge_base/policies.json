      "kochi": ["Kerala", "India"], "thiruvananthapuram": ["Kerala", "India"], "ahmedabad": ["Gujarat", "India"],
      "jaipur": ["Rajasthan", "India"], "lucknow": ["Uttar Pradesh", "India"], "bhubaneswar": ["Odisha", "India"],
      "london": ["England", "United Kingdom"], "manchester": ["England", "United Kingdom"], "edinburgh": ["Scotland", "United Kingdom"],
      "new york": ["New York State", "United States"], "san francisco": ["California", "United States"], "los angeles": ["California", "United States"],
      "seattle": ["Washington State", "United States"], "boston": ["Massachusetts", "United States"], "chicago": ["Illinois", "United States"],
      "toronto": ["Ontario", "Canada"], "berlin": ["Berlin", "Germany"], "paris": ["Ile-de-France", "France"],
      "singapore": ["Singapore", "Singapore"], "sydney": ["New South Wales", "Australia"], "dubai": ["Dubai", "United Arab Emirates"]
    },
