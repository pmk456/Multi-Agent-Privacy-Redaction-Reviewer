# Copy to .env and fill in. .env is git-ignored — never commit a real key.

ANTHROPIC_API_KEY=sk-ant-...

# Claude is optional - every agent works without it. Defaults keep usage minimal.
LLM_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=low
# disabled | adaptive
LLM_THINKING=disabled
LLM_MAX_TOKENS=1024
# hard cap on Claude calls per batch of documents
LLM_MAX_CALLS_PER_BATCH=3

# Where original and redacted documents live. Must stay outside the frontend.
PROTECTED_STORE_PATH=./protected_store
DATABASE_URL=sqlite:///./privacy_review.db

# Hard switch: when true the API refuses to serialise any raw entity value.
ENFORCE_NO_RAW_PII=true
